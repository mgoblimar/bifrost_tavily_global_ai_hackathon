{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "drop_excess_requests": false,
    "enforce_auth_on_inference": true
  },
  "providers": {
    "groq": {
      "keys": [
        {
          "name": "groq-key-1",
          "value": "env.GROQ_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ]
    },
    "gemini": {
      "keys": [
        {
          "name": "gemini-key-1",
          "value": "env.GEMINI_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ]
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-fresh-facts",
        "name": "fresh-facts-app",
        "value": "env.BIFROST_VIRTUAL_KEY",
        "description": "Key used by the Streamlit app; capped by a monthly budget",
        "is_active": true,
        "allow_all_providers": true
      }
    ],
    "budgets": [
      {
        "id": "budget-fresh-facts",
        "virtual_key_id": "vk-fresh-facts",
        "max_limit": 5.0,
        "reset_duration": "1M"
      }
    ]
  }
}
