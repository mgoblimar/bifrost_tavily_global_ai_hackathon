# Copy this file to .env and fill in your keys. Never commit .env.

# Model providers (read by the Bifrost gateway, not by the app)
GROQ_API_KEY=
GEMINI_API_KEY=

# Tavily web search (read by the app)
TAVILY_API_KEY=

# Bifrost gateway (port 8090 because 8080 is often taken)
BIFROST_URL=http://localhost:8090
# Virtual key the app sends to Bifrost. Any value starting with sk-bf-
BIFROST_VIRTUAL_KEY=
# One-time token for creating the Bifrost dashboard admin account
BIFROST_SETUP_TOKEN=

# Models, in Bifrost "provider/model" form.
# FAST handles claim extraction, STRONG handles verification.
# Each falls back to the other provider if its own is down or rate-limited.
FAST_MODEL=groq/openai/gpt-oss-20b
FAST_FALLBACK=gemini/gemini-flash-lite-latest
STRONG_MODEL=gemini/gemini-3.5-flash
STRONG_FALLBACK=groq/openai/gpt-oss-120b
